includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    level: 6

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes

    # No baseline on purpose: a new error is fixed, not filed away.
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false
