# Copy to .env.testing (php artisan dash:install does this for you) and run
# `php artisan key:generate --env=testing`.
#
# Tests wipe this database on every run, so it must never be your real one.
# The test suite refuses to start unless the name contains "_testing".
#
# Parallel runs (`composer test`) create one database per process, named
# <DB_DATABASE>_test_<n>, so DB_USERNAME needs the global CREATE privilege:
#   GRANT ALL PRIVILEGES ON `my_app_testing%`.* TO 'user'@'localhost';

APP_NAME=GhostDash
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

ADMIN_PANEL_PATH=admin
FRONTEND_URL=http://localhost:3000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=my_app_testing
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SANCTUM_TOKEN_EXPIRATION=1440
ACTIVITYLOG_RETENTION_DAYS=365
BACKUP_DISK=backups
