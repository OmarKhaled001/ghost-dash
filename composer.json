{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "omarkhaled001/ghost-dash",
    "type": "project",
    "description": "GhostDash: Fast. Quiet. Secure. Your bilingual Laravel admin in one command.",
    "keywords": [
        "laravel",
        "filament",
        "admin-panel",
        "starter-kit",
        "arabic",
        "rtl",
        "mysql"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo_mysql": "*",
        "ext-tokenizer": "*",
        "ext-xml": "*",
        "ext-zip": "*",
        "bezhansalleh/filament-language-switch": "^5.1",
        "bezhansalleh/filament-shield": "^4.3",
        "filament/filament": "^5.11",
        "filament/spatie-laravel-settings-plugin": "^5.11",
        "laravel/framework": "^13.42",
        "laravel/prompts": "^0.3.27",
        "laravel/sanctum": "^4.4",
        "laravel/telescope": "^5.28",
        "laravel/tinker": "^3.1",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-backup": "^10.4",
        "spatie/laravel-health": "^1.41",
        "spatie/laravel-permission": "^8.5",
        "spatie/laravel-settings": "^3.10"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.15",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.3",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php artisan dash:install"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": "pint",
        "lint:check": "pint --test",
        "refactor": "rector",
        "refactor:check": "rector --dry-run",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": [
            "@php artisan config:clear --ansi",
            "pest --parallel"
        ],
        "check": [
            "@lint:check",
            "@refactor:check",
            "@analyse",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan key:generate --ansi",
            "@php artisan dash:post-create --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ],
            "installer": {
                "post-create-project": [
                    "@php artisan dash:post-create --ansi"
                ]
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "abandoned": "report"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "setup": "Install PHP dependencies, then run the GhostDash installer (for git clones).",
        "dev": "Run the server, queue worker, log tail and Vite together.",
        "lint": "Fix code style with Pint.",
        "lint:check": "Fail if Pint would change anything.",
        "refactor": "Apply Rector refactorings.",
        "refactor:check": "Fail if Rector would change anything.",
        "analyse": "Run Larastan static analysis.",
        "test": "Run the Pest suite in parallel against the MySQL testing database.",
        "check": "Everything CI runs: lint:check, refactor:check, analyse, test."
    }
}
