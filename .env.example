APP_NAME=GhostDash
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Path of the Filament panel: APP_URL/admin by default.
ADMIN_PANEL_PATH=admin

# Where the end-user frontend lives. API password reset links point here.
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.4 LTS is the only supported database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=my_app
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# Directory that contains mysqldump, when it is not on PATH (used by backups).
DB_DUMP_BINARY_PATH=

# Addresses or ranges of the load balancer or reverse proxy in front of the
# app, comma-separated (10.0.0.0/8). Avoid *: see config/trustedproxy.php.
# TRUSTED_PROXIES=

# Outside local, requests are only answered for APP_URL's host and its
# subdomains. Further host names, comma-separated regular expressions.
# TRUSTED_HOSTS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Lifetime of API tokens in minutes (1440 = 24 hours).
SANCTUM_TOKEN_EXPIRATION=1440
# Comma-separated SPA domains that may use cookie-based Sanctum auth.
# SANCTUM_STATEFUL_DOMAINS=

# The SEO menu in the panel, <x-seo> and GET /api/v1/seo. php artisan dash:seo
# switches it on.
GHOSTDASH_SEO=false

# Telescope is only loaded when this is true. Keep it false in production
# and switch it on temporarily when you need to debug.
TELESCOPE_ENABLED=true

# Activity log entries older than this many days are deleted every night.
ACTIVITYLOG_RETENTION_DAYS=365

# Disk (config/filesystems.php) that receives backups, and who is told about them.
BACKUP_DISK=backups
BACKUP_NOTIFICATION_EMAIL=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
